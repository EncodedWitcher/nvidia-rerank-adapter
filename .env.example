# ==============================================
# NVIDIA Rerank & Embeddings Adapter 配置模板
# ==============================================
# 复制此文件为 .env 并填写您的配置

# ----------------------------------------------
# NVIDIA API 密钥 (必需)
# ----------------------------------------------
# 多个密钥用逗号分隔，支持轮询负载均衡
NVIDIA_API_KEYS=nvapi-your-key-1,nvapi-your-key-2

# ----------------------------------------------
# 模型配置
# ----------------------------------------------
# 默认 Rerank 模型
DEFAULT_MODEL=nvidia/rerank-qa-mistral-4b

# 默认 Embedding 模型 (当上游模型找不到时使用)
DEFAULT_EMBEDDING_MODEL=baai/bge-m3

# NVIDIA Embeddings API 地址
NVIDIA_EMBEDDINGS_URL=https://integrate.api.nvidia.com/v1/embeddings

# ----------------------------------------------
# 服务器配置
# ----------------------------------------------
HOST=0.0.0.0
PORT=8000

# API 请求超时时间（秒）
REQUEST_TIMEOUT=30

# 所有密钥都遇到 429 时的等待时间（秒）
RETRY_WAIT_SECONDS=5

# ----------------------------------------------
# 认证配置（可选）
# ----------------------------------------------
# 设置后，客户端需要在请求头中携带此密钥
# Authorization: Bearer <API_KEY>
API_KEY=
