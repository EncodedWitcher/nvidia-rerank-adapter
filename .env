# NVIDIA Rerank Adapter Configuration

# NVIDIA API Keys (comma-separated for multiple keys)
# Example: NVIDIA_API_KEYS=nvapi-key1,nvapi-key2,nvapi-key3
NVIDIA_API_KEYS=

# Default NVIDIA model to use
DEFAULT_MODEL=nvidia/rerank-qa-mistral-4b

# Server configuration
HOST=0.0.0.0
PORT=8000

# Request timeout in seconds
REQUEST_TIMEOUT=30

# API Key for authentication (optional - leave empty to disable authentication)
# Clients must send this key in the Authorization header: "Bearer <API_KEY>"
API_KEY=